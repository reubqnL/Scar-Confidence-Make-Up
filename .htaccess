Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^(?:config|components|node_modules|tests|scripts/dev\.mjs|scripts/copy-fonts\.mjs)(?:/|$) - [F,L]
RewriteRule ^(?:schema\.sql|package(?:-lock)?\.json|tsconfig\.json|vite\.config\.ts|router\.php|README\.md|Project-Notes\.md)$ - [F,L]
RewriteRule (^|/)\. - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
